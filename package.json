{
  "name": "react-example",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3993 --host=0.0.0.0 2>&1 | grep -v \"@ljharb/tsconfig\"",
    "build": "vite build",
    "preview": "vite preview --port=3993 --host=0.0.0.0 2>&1 | grep -v \"@ljharb/tsconfig\"",
    "clean": "rm -rf dist",
    "clean:full": "bash scripts/rebuild.sh",
    "lint": "tsc --noEmit && eslint src/ && cd server && tsc --noEmit && npm run lint",
    "test": "vitest run && cd server && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "analyze:graph": "codegraph index",
    "analyze:graph:init": "codegraph init -i",
    "prepare": "husky",
    "lint:deps": "depcruise src server/src",
    "lint:deps:graph": "depcruise src server/src --include-only \"^src|^server/src\" --output-type dot | dot -T svg > dependency-graph.svg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze-bundle": "ANALYZE_BUNDLE=true npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dequal": "^2.0.3",
    "dexie": "^4.4.4",
    "i18next": "^26.3.1",
    "lucide-react": "^0.546.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "vite": "^6.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^0.9.9",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.3",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
